# Configuração exclusiva do Compose local. Gerar .env com node scripts/prepare-compose.mjs.
# Senha e token devem ser hexadecimais; não reutilizar os exemplos da API em produção.
POSTGRES_PASSWORD=
API_ACCESS_TOKEN=
DASHBOARD_PORT=8080
# Vazio usa a data atual em São Paulo ao carregar os chamados fictícios.
SEED_REFERENCE_DATE=
