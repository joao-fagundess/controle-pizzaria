# Configuração do banco local; não usar estas credenciais em produção.
DATABASE_URL=postgresql://dashboard:dashboard_local@localhost:5432/thindesk_dashboard
# Opcional: fixa o calendário do seed para reproduzir uma demonstração.
SEED_REFERENCE_DATE=2026-11-11

# API local. Fora de loopback ou em produção, API_ACCESS_TOKEN é obrigatório (mínimo 32 caracteres).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# API_ACCESS_TOKEN=

# Preencher somente ao receber acesso autorizado à instância do Thindesk.
# THINDESK_BASE_URL=https://suporte.example.invalid/
# THINDESK_USERNAME=
# THINDESK_PASSWORD=
# Alternativa ao login: cookie de uma sessão já autenticada.
# THINDESK_SESSION_COOKIE=
