{
  "name": "thindesk-dashboard-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.mjs seed",
    "test:database": "node --test tests/database.test.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:demo": "node --env-file-if-exists=.env dist/server.js --demo",
    "test:api": "vitest run",
    "test": "npm run typecheck && npm run test:database && npm run test:api",
    "docs:openapi": "node scripts/export-openapi.mjs",
    "thindesk:sync": "node --env-file-if-exists=.env dist/thindesk-sync.js",
    "thindesk:sync:v1": "node --env-file-if-exists=.env dist/thindesk-analytics-sync.js",
    "db:explain": "node scripts/explain-dashboard.mjs",
    "test:smoke": "node scripts/smoke-api.mjs",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "node scripts/test-postgres.mjs",
    "validate": "node scripts/validate.mjs",
    "test:thindesk-contract": "node --test ../integration/thindesk/contract.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "pg": "8.23.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@electric-sql/pglite": "0.5.16",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.1.0",
    "embedded-postgres": "18.6.0-beta.19",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
