# Destino do proxy de desenvolvimento/prévia; não é enviado ao navegador.
API_PROXY_TARGET=http://127.0.0.1:3000
# Somente se a API exigir bearer; manter o mesmo token no ambiente do backend.
# API_ACCESS_TOKEN=
# URL pública da API. Prefira mesma origem /api/v1 em produção, com gateway autenticado.
VITE_API_BASE_URL=/api/v1
# Segundos de polling inicial: 0 desativa. A interface permite alterar durante a sessão.
VITE_POLL_INTERVAL_SECONDS=60
