# O token é substituído na inicialização do servidor e nunca integra os assets do navegador.
server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ready';
    }

    location /api/ {
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer ${API_ACCESS_TOKEN}";
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }

    location = /api {
        return 404;
    }

    location = /docs {
        return 308 /docs/;
    }

    location /docs/ {
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ /\. {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }
}
